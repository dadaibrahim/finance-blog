---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
// Google AdSense Client ID configuration
const adClientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID || '';

// Umami Analytics configuration
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL || import.meta.env.NEXT_PUBLIC_UMAMI_SCRIPT_URL || 'https://central-analytics.vercel.app/script.js';
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || import.meta.env.NEXT_PUBLIC_UMAMI_WEBSITE_ID || '';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="google-site-verification" content="_IlxZPXBIc0lQ7u3UMHWRdfSts0nHmAc0aZHwEKd3Hg" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />

<!-- Google AdSense Auto Script (Loads when PUBLIC_ADSENSE_CLIENT_ID is configured) -->
{
	adClientId && (
		<script
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClientId}`}
			crossorigin="anonymous"
		/>
	)
}

<!-- Umami Analytics Tracker Script -->
{
	umamiWebsiteId && (
		<script
			async
			src={umamiScriptUrl}
			data-website-id={umamiWebsiteId}
		/>
	)
}


