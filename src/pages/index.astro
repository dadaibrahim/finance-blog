---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const focusTopics = [
	{
		title: 'Build a budgeting system that actually lasts',
		category: 'Budgeting',
		blurb: 'Simple frameworks for turning financial goals into repeatable habits that work in real life.',
	},
	{
		title: 'How to start investing without overcomplicating it',
		category: 'Investing',
		blurb: 'A beginner-friendly approach to risk, diversification, and building confidence with your portfolio.',
	},
	{
		title: 'The debt payoff playbook that reduces stress fast',
		category: 'Debt',
		blurb: 'Strategy-first advice for paying down debt without sacrificing your essential priorities.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.finance-shell {
				padding: 2rem 0 4rem;
			}
			.hero {
				display: grid;
				grid-template-columns: 1.3fr 0.7fr;
				gap: 1.5rem;
				margin-bottom: 2rem;
			}
			.hero-card,
			.topic-card {
				background: rgba(255,255,255,0.72);
				border: 1px solid rgba(96,115,159,0.18);
				border-radius: 18px;
				padding: 1.5rem;
				box-shadow: 0 18px 38px rgba(15,18,25,0.08);
			}
			.kicker {
				display: inline-block;
				padding: 0.4rem 0.7rem;
				border-radius: 999px;
				background: #ecfdf5;
				color: #0f766e;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.hero-card h1 {
				font-size: clamp(2.5rem, 5vw, 4.3rem);
				line-height: 0.96;
				margin: 1rem 0;
			}
			.hero-card p {
				font-size: 1.1rem;
				margin-bottom: 0;
			}
			.side-stack {
				display: grid;
				gap: 1rem;
			}
			.topic-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1.25rem;
			}
			.topic-card h2 {
				font-size: 1.4rem;
				margin: 0.85rem 0 0.5rem;
			}
			.topic-card p {
				margin: 0;
			}
			.callout {
				margin-top: 2rem;
				padding: 1.5rem;
				background: linear-gradient(135deg, #0f766e, #0f172a);
				color: white;
				border-radius: 18px;
			}
			.callout h3 {
				color: white;
				margin-bottom: 0.5rem;
			}
			.intro-copy {
				margin-top: 2.5rem;
				max-width: 720px;
			}
			.intro-copy h2 {
				font-size: 1.5rem;
				margin-bottom: 0.75rem;
			}
			.intro-copy p {
				line-height: 1.65;
				margin: 0 0 1rem;
			}
			@media (max-width: 900px) {
				.hero,
				.topic-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="finance-shell">
			<section class="hero">
				<div class="hero-card">
					<span class="kicker">This week</span>
					<h1>Money systems that help you grow with less stress.</h1>
					<p>Wealth Notes is a practical personal finance blog for budgeting, saving, investing, and building a life that feels financially secure—not just technically optimized.</p>
				</div>
				<div class="side-stack">
					<div class="topic-card">
						<span class="kicker">Save smarter</span>
						<h2>Emergency funds are the foundation of good money decisions.</h2>
					</div>
					<div class="topic-card">
						<span class="kicker">Think long-term</span>
						<h2>Compounding works best when your habits are boring and consistent.</h2>
					</div>
				</div>
			</section>

			<section class="topic-grid">
				{focusTopics.map((topic) => (
					<article class="topic-card">
						<span class="kicker">{topic.category}</span>
						<h2>{topic.title}</h2>
						<p>{topic.blurb}</p>
					</article>
				))}
			</section>

			<section class="callout">
				<h3>Money, simplified.</h3>
				<p>Clear guidance for everyday income, spending, investing, and financial calm—without the noise of hype-driven finance.</p>
			</section>

			<section class="intro-copy">
				<h2>Why Wealth Notes exists</h2>
				<p>
					Most personal finance advice either assumes you already have money to spare, or buries a simple idea under jargon. Wealth Notes takes the opposite approach: short, direct guides that start from where most people actually are — a budget that keeps slipping, a first investment account, a debt balance that needs a real plan instead of a vague goal.
				</p>
				<p>
					New articles cover budgeting systems, beginner investing, and debt payoff strategy, and they live in the <a href="/blog">Journal</a>. If you want more on the approach behind the site, read <a href="/about">About</a>.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
